# RPGA Feather iCE5LP4K pin constraints.
# Source pin map mirrored from the sister ice40_spi_io_expander/common/io.pcf.

# Existing sideband debug/reset interface.
set_io clk 2
set_io enable 3
set_io data 4
set_io data_out 6

# Open-drain I2C wiring to the BMA530 breakout.
set_io I2C_SCL 13
set_io I2C_SDA 20
set_io RGB0 39
set_io RGB1 40
set_io RGB2 41

# SPI from RP2040 to FPGA
set_io SPI_SS 16
set_io SPI_SCK 15
set_io SPI_MOSI 17
set_io SPI_MISO 14
